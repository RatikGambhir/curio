# Required service credentials. Keep values local and never commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Required database configuration. Use the application role for DATABASE_URL
# and the schema owner/migrator role for CURIO_MIGRATOR_DATABASE_URL.
DATABASE_URL=
CURIO_MIGRATOR_DATABASE_URL=
CURIO_DB_SCHEMA=curio_dev

# Integration tests use a test-runner role that can create and drop only
# disposable curio_test_* schemas. Never put a production URL here.
CURIO_TEST_DATABASE_URL=

# Optional development defaults.
OPENAI_BASE_URL=https://api.openai.com
CURIO_SERVICE_ADDR=127.0.0.1:3000
CURIO_DB_MAX_CONNECTIONS=5
CURIO_DB_ACQUIRE_TIMEOUT_SECONDS=10
CURIO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional structured-log filter. Keep secrets and user content out of logs.
RUST_LOG=curio_service=info
